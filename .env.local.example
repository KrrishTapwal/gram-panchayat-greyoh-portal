# ─── MongoDB Atlas ─────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gram-panchayat-greyoh?retryWrites=true&w=majority

# ─── JWT Secret (generate a strong random string) ─────────────────────────
# Run in terminal:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_random_string_here

# ─── Cookie Config ─────────────────────────────────────────────────────────
# Set to 'true' in production (HTTPS required)
COOKIE_SECURE=false

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
